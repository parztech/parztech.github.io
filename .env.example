# Database: leave empty locally to use ./local.db (SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub usernames allowed into /admin
ADMIN_GITHUB_LOGINS=

# Local only: one-click admin login during `npm run dev` (ignored in production)
AUTH_DEV_LOGIN=true
